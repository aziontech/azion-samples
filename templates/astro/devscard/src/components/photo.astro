---
import type { Photo } from '@/types/shared';
import { Image } from 'astro:assets';

export interface Props {
  src: Photo;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { src, class: className, ...props } = Astro.props;

const isRemoteImage = typeof src === 'string';
const loading = import.meta.env.PUBLIC_APP_ENV === 'snapshot' ? 'eager' : 'lazy';
---

{
  isRemoteImage ? (
    <img src={src} class={className} {...props} />
  ) : (
    // `object-cover` replaces the removed `fit="cover"` from @astrojs/image (astro:assets crops via CSS).
    <Image format="webp" src={src} loading={loading} class:list={['object-cover', className]} {...props} />
  )
}
